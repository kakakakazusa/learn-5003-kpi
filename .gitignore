# ============ General ============
.DS_Store
Thumbs.db
desktop.ini
*.log
.idea/
.vscode/
*.swp

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
