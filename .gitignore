# ============ Environment variables and secrets ============
# .env holds database passwords / SECRET_KEY — never commit it
.env
.env.local
.env.*.local
# Keep the template so others can reproduce the setup
!.env.example

# ============ Local databases ============
# SQLite files are local dev data and can be rebuilt with the ETL scripts
instance/
*.db
*.sqlite3
*.db-journal

# ============ Frontend ============
node_modules/
dist/
dist-ssr/
*.local

# ============ Tooling / local workspace ============
# .workbuddy is the local agent workspace and memory — keep it out of git
.workbuddy/
.history/

# ============ Temporary files ============
tmp/
temp/
*.tmp
