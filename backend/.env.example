# Copy to .env and adjust as needed
PORT=8000
SECRET_KEY=change-me
# 默认使用 SQLite（backend/instance/analytics.db），无需额外安装数据库
# DATABASE_URL=sqlite:///analytics.db
# 切换 MySQL 前先建库：CREATE DATABASE analytics CHARACTER SET utf8mb4;
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/analytics?charset=utf8mb4
FLASK_DEBUG=0
# Comma-separated origins for production
CORS_ORIGINS=http://localhost:5173