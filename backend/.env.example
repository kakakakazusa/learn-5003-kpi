# Copy this file to .env and adjust as needed
PORT=8000
SECRET_KEY=change-me
FLASK_DEBUG=0
# Comma-separated origins in production; do not use *
CORS_ORIGINS=http://localhost:5173

# ---------- Default bind (optional) ----------
# All models live on the dw bind; the default bind is only a placeholder and
# falls back to DW_DATABASE_URL when unset.
# Only set it separately if you want the warehouse tables in a different database.
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/5003?charset=utf8mb4

# ---------- Warehouse database (dw bind, required by the dashboard APIs) ----------
# Create it first: CREATE DATABASE `5003` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DW_DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/5003?charset=utf8mb4

# ---------- Redis cache (optional; falls back silently when unavailable) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
DW_CACHE_TTL=86400

# Note: database/etl does NOT read this file. It is configured through the
# DW_DB_HOST / DW_DB_USER / DW_DB_PASSWORD / DW_DB_PORT / DW_DB_NAME / DW_RUN_TIME
# environment variables, defaulting to root:root@127.0.0.1:3306/5003
