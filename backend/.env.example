# 复制为 .env 后按需修改
PORT=8000
SECRET_KEY=change-me
FLASK_DEBUG=0
# 生产环境逗号分隔，不要用 *
CORS_ORIGINS=http://localhost:5173

# ---------- 默认 bind（可选） ----------
# 全部模型都在 dw bind；默认 bind 只作占位，不设置时与 DW_DATABASE_URL 同源。
# 仅当要把数仓表拆到另一个库时才需要单独配置。
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/5003?charset=utf8mb4

# ---------- 数仓库（dw bind，看板接口依赖） ----------
# 先建库：CREATE DATABASE `5003` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DW_DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/5003?charset=utf8mb4

# ---------- Redis 缓存（可选，连不上自动降级） ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
DW_CACHE_TTL=86400

# 注意：database/etl 不读本文件，通过 DW_DB_HOST / DW_DB_USER / DW_DB_PASSWORD /
# DW_DB_PORT / DW_DB_NAME / DW_RUN_TIME 环境变量配置，默认 root:root@127.0.0.1:3306/5003
